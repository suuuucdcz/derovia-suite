# Copier en `.env` et renseigner les valeurs du projet Supabase.
#
# La cle anon se trouve dans Project Settings > API. Elle est publique par
# conception. Ne jamais utiliser la cle service_role dans un client.
#
# ATTENTION : changer d'URL impose de mettre a jour connect-src dans
# apps/derovia-arbitrage/src-tauri/tauri.conf.json.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon
