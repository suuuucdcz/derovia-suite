{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Derovia",
  "version": "0.2.2",
  "identifier": "com.derovia.arbitrage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Derovia",
        "width": 1320,
        "height": 880,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; connect-src 'self' https://rcxbjwnzmnnmpxhhknix.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Derovia",
    "shortDescription": "Suite d'outils d'automatisation",
    "longDescription": "Derovia Arbitrage compare l'achat et la location d'un logement, d'un vehicule ou de materiel professionnel, et dit laquelle des deux options laisse le plus de patrimoine a l'horizon choisi."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/suuuucdcz/derovia-suite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NTQzOUYxQzFFQ0FEMEIKUldRTHJlekI4VGxVdU1tRlEvTWR4MWdNaHpIRndGSFFWUS9NZ0V5VCs4L0hmcWxxdlRNRkNCRnYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
