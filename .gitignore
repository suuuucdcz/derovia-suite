# Rust
/target
**/target
Cargo.lock.bak

# Node / frontend
node_modules
dist
.vite

# Configuration locale : l'exemple est versionne, pas les vraies valeurs.
.env
.env.local
!.env.example

# Tauri
apps/*/src-tauri/target
apps/*/src-tauri/gen

# Documentation API generee (lourde, regenerable via scripts/docs.ps1 -Regenerer)
/target/doc

# Les fichiers prepares pour une publication : ils sortent de la compilation,
# ils n'ont rien a faire dans l'historique.
/dist-release

# OS / editeurs
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/

# Cle privee de signature des mises a jour. NE JAMAIS COMMITER.
# La perdre rend toute mise a jour future impossible pour les installations
# existantes : il faut la sauvegarder ailleurs, hors du depot.
/.secrets/
